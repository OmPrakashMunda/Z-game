# World clock speed: 1 real second = VITE_TIME_SCALE game seconds.
# 24 means 1 game day = 1 real hour. Restart `npm run dev` after changing.
# Only the world clock is scaled (days, needs, crops, build/delivery times).
# Walking, combat and zombie movement always run at normal speed.
# NOTE: Variables starting with VITE_ are visible in the browser. Never put secrets here.
VITE_TIME_SCALE=24
