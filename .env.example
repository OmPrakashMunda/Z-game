# Copy this file to .env.local and fill it in to turn on Google sign-in and cloud saves.
# Leave the values out and the game still works as a guest with saves on this device.
# These web keys are not secrets: what protects the data is firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 to switch Firebase off even when the settings above are filled in.
VITE_FIREBASE_DISABLED=
